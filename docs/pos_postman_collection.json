            },
            "url": {
              "raw": "{{base_url}}/admin/pos/registers/{{pos_register_id}}/sessions",
              "host": ["{{base_url}}"],
              "path": ["admin", "pos", "registers", "{{pos_register_id}}", "sessions"]
            },
            "description": "Zatvara otvorenu smjenu, bilježi završno stanje gotovine i priprema podatke za dnevni zaključak."
          },
          "response": []
        }
      ]
    }
  ]
}
